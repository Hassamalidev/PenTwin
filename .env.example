# Copy to .env and fill in. Never commit .env.

# --- Export worker (apps/worker) ---
# Port the worker listens on.
WORKER_PORT=8787
# Where finished PDFs are kept for up to 24 hours. Defaults to a folder in the system temp directory.
EXPORT_STORAGE_DIR=
# Signs download links. At least 16 characters; use a long random value in production,
# for example the output of: openssl rand -hex 32
# If unset, the worker makes up a temporary one each time it starts (development only).
EXPORT_SIGNING_SECRET=
# Origin of the web app, allowed to call the worker from the browser.
WEB_ORIGIN=http://localhost:3000

# --- Accounts, pages and payments ---
# Leave DATABASE_URL empty to run the worker without accounts: exporting is then open to
# anyone and unmetered, which is only for trying things out locally.
# When it is set, every other variable in this section marked "required" must be set too.

# Postgres connection string of the Supabase project (Settings > Database). Use the
# service connection, not a client key. Apply supabase/migrations first.
DATABASE_URL=
# Required. The project's JWT secret (Settings > API). Used to check who is signed in.
SUPABASE_JWT_SECRET=
# Required. Secret key of the Paddle notification destination (Developer tools > Notifications).
PADDLE_WEBHOOK_SECRET=
# Paddle price ids (Catalog > Products). Unset ones are simply not recognised.
PADDLE_PRICE_STUDENT_MONTH=
PADDLE_PRICE_STUDENT_YEAR=
PADDLE_PRICE_PRO_MONTH=
PADDLE_PRICE_PRO_YEAR=
PADDLE_PRICE_TOP_UP=
# Required. Encrypts stored handwriting profiles. At least 32 characters, long and random.
# Losing it makes every stored profile unreadable; changing it does the same.
PROFILE_ENCRYPTION_KEY=
# Where encrypted profiles are kept. Defaults to a folder in the system temp directory,
# which is NOT suitable for production: use a persistent disk.
PROFILE_STORAGE_DIR=
# Required. Mixed into network-address and device fingerprints before they are stored.
FINGERPRINT_SALT=
# Protects GET /admin/costs. Leave empty to switch that page off.
ADMIN_TOKEN=
# Transactional email through Resend. Without these, emails wait in the database unsent.
RESEND_API_KEY=
EMAIL_FROM=

# --- Web app (apps/web) ---
# Where the browser reaches the export worker.
NEXT_PUBLIC_WORKER_URL=http://localhost:8787
