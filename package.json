{
  "name": "pentwin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "fixtures:glyphs": "tsx scripts/build-test-glyphs.ts",
    "samples": "tsx scripts/make-samples.ts",
    "bench": "tsx scripts/bench.ts",
    "sample:check": "tsx scripts/check-sample-text.ts",
    "sample:sheet": "tsx scripts/make-sample-sheet.ts",
    "extract:measure": "tsx scripts/measure-extraction.ts",
    "extract:demo": "tsx scripts/extract-demo.ts",
    "benchmark": "tsx scripts/make-benchmark.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "web": "pnpm --filter @pentwin/web dev",
    "web:build": "pnpm --filter @pentwin/web build",
    "e2e": "playwright test",
    "db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.test.yml down",
    "test:db": "vitest run --config vitest.db.config.ts",
    "worker:build": "esbuild apps/worker/src/main.ts --bundle --platform=node --target=node22 --format=cjs --legal-comments=none --external:pg-native --outfile=dist/worker/main.cjs",
    "load:test": "tsx scripts/load-test.ts",
    "e2e:browsers": "playwright test --project=firefox --project=webkit --project=iphone-emulated --project=android-emulated",
    "db:restore-check": "tsx scripts/backup-restore-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "docx": "^9.9.0",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
